# Frontend env — copy to .env.local. Never put the Gemini key here (it ships to the browser).

# When these two are set, the app uses Supabase Auth + persists progress, and
# calls the deployed edge function via supabase-js. Without them the app still
# runs in "local mode" (no sign-in, progress kept only in memory).
# VITE_SUPABASE_ANON_KEY accepts the publishable key (sb_publishable_…) — it is
# meant to ship to the browser. Run supabase/migrations/0001_init_progress.sql
# and set the Auth URL configuration first (see that file's header).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When they are NOT set, the app falls back to a locally served function:
#   supabase functions serve --env-file supabase/.env.local
VITE_AI_ENDPOINT=http://localhost:54321/functions/v1/ai
