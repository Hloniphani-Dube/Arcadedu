# Frontend env — copy to .env.local. Never put the Gemini key here (it ships to the browser).

# When these two are set, the app calls the deployed edge function via supabase-js:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When they are NOT set, the app falls back to a locally served function:
#   supabase functions serve --env-file supabase/.env.local
VITE_AI_ENDPOINT=http://localhost:54321/functions/v1/ai
