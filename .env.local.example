# Frontend env — copy to .env.local. .env.local is gitignored.

# --- AI (required) --------------------------------------------------------
# The app calls a closed-action AI endpoint. On Vercel this is the bundled
# serverless function at /api/ai (see api/ai.ts).
VITE_AI_ENDPOINT=/api/ai

# Server-only — read by api/ai.ts, never shipped to the browser (no VITE_
# prefix). For local `vercel dev` only; in production set this in the Vercel
# dashboard (Project Settings → Environment Variables), not here.
# Key from https://aistudio.google.com/apikey  (looks like AIzaSy...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Auth + saved progress (optional) ----------------------------------------
# When these two are set, the app uses Supabase Auth + persists progress.
# Without them it runs in "local mode" (no sign-in, progress kept in memory).
# VITE_SUPABASE_ANON_KEY accepts the publishable key (sb_publishable_…).
# Run supabase/migrations/0001_init_progress.sql and set the Auth URL config
# first (see that file's header).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
